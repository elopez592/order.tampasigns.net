# Examples only. The Python app reads process environment variables, not this file automatically.
# Docker Compose can load these through an env_file entry if you configure one.
APP_ENV=production
PUBLIC_URL=https://shop.your-domain.example
DATA_DIR=/data
ALLOWED_HOSTS=shop.your-domain.example,127.0.0.1
DEMO_SEED=0
ADMIN_EMAIL=owner@your-domain.example
# Set only for initial account creation; omit to generate a random password.
# ADMIN_PASSWORD=choose-a-new-long-unique-password
# Enable only behind a trusted TLS reverse proxy and restrict its IPs.
TRUST_PROXY=0
FORWARDED_ALLOW_IPS=127.0.0.1

# Optional hosted card checkout. Use TEST credentials for staging.
# Leave empty until the account is connected. These are SERVER ONLY secrets.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
