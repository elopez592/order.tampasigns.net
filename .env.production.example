# Copy to .env.production ON THE SERVER. Never commit that copy.
# The host below is a placeholder, not a deployed address.
SITE_HOST=orders.your-domain.example
ADMIN_EMAIL=owner@your-domain.example
# Set a unique initial password through the hosting secret store, or let the
# first run generate one. Change it after sign-in. Do not reuse test passwords.
# ADMIN_PASSWORD=
# Keep these empty until connecting your own Stripe TEST account.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
